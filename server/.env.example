# Suraksha Setu — Node.js Backend Environment Variables (Render / Production)

# Server Environment Configuration
PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (comma-separated if multiple domains)
FRONTEND_ORIGIN=https://suraksha-setu.vercel.app,http://localhost:5173
CLIENT_URL=https://suraksha-setu.vercel.app

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://surakshasetu81_db_user:<db_password>@cluster0.ws4exya.mongodb.net/suraksha-setu?retryWrites=true&w=majority

# JWT Authentication (generate strong random keys in production)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Cookie Security (generate strong random keys in production)
COOKIE_SECRET=your_cookie_secret_change_in_production

# File Upload Configuration (Default 10MB)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/

# Optional Python ML Service URL (Render service URL or internal URL)
ML_SERVICE_URL=https://suraksha-setu-ml.onrender.com
ML_TIMEOUT_MS=2500
